meta {
  name: Update User Role (Admin)
  type: http
  seq: 4
}

put {
  url: {{audit_base_url}}/api/roles/users/{{user_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{admin_token}}
}

body:json {
  {
    "roleName": "{{role_name}}"
  }
}
