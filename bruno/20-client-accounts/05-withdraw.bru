meta {
  name: Withdraw Cash
  type: http
  seq: 5
}

post {
  url: {{client_base_url}}/api/accounts/{{account_id}}/withdraw
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{client_token}}
}

body:json {
  {{withdraw_amount}}
}
