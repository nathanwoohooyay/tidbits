meta {
  name: Create Account
  type: http
  seq: 1
}

post {
  url: {{client_base_url}}/api/users/{{user_id}}/accounts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{client_token}}
}

body:json {
  "{{account_nickname}}"
}
