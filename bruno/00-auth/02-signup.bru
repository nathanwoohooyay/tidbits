meta {
  name: Signup
  type: http
  seq: 2
}

post {
  url: {{auth_base_url}}/api/auth/signup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "username": "{{signup_username}}",
    "email": "{{signup_email}}",
    "password": "{{signup_password}}",
    "phoneNumber": "{{signup_phone}}"
  }
}
