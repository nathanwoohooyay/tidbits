# Copy to .env in the repo root on the EC2 instance and fill in. Never commit the filled-in file.
# Postgres runs in a container on the same instance; these set up its database and login on first start.
DB_NAME=tidbits_dev
DB_USER=postgres
DB_PASSWORD=
# Make a new one for production: openssl rand -base64 48
JWT_SECRET=
FAUXNANCE_API_KEY=
# Your two CloudFront URLs, comma-separated.
AUTH_CORS_ORIGINS=https://dxxxxclient.cloudfront.net,https://dxxxxaudit.cloudfront.net
GATEWAY_CORS_ORIGINS=https://dxxxxclient.cloudfront.net,https://dxxxxaudit.cloudfront.net
