meta {
  name: Update User
  type: http
  seq: 2
}

put {
  url: {{client_base_url}}/api/users/{{user_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{client_token}}
}

body:json {
  {
    "email": "updated_{{signup_email}}",
    "phoneNumber": "{{signup_phone}}"
  }
}
