meta {
  name: Place Order
  type: http
  seq: 1
}

post {
  url: {{client_base_url}}/api/accounts/{{account_id}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{client_token}}
}

body:json {
  {
    "instrumentId": {{instrument_id}},
    "quantity": 1.25,
    "orderType": "BUY"
  }
}
